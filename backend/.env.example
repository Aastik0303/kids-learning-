LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# The AI Teacher playground's own model: the biggest one the account has.
GROQ_TEACHER_MODEL=openai/gpt-oss-120b
# The guide's voice, and the only one: Microsoft Edge's free neural voices.
# No key. This one reads English and Devanagari in the same sentence, which is
# how the app narrates Hindi. `edge-tts --list-voices` prints the rest.
EDGE_TTS_VOICE=hi-IN-SwaraNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
ENV=development
# The key that signs a parent's session token. Generate a fresh one per
# environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real one, and never reuse the development key in production -
# outside development an unset secret makes sign-in refuse rather than fall
# back to something guessable.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=saksham-iq
JWT_AUDIENCE=saksham-iq-app
# Thirty days, matching the auth_sessions row the token names.
JWT_TTL_MINUTES=43200

# --- Google Sign-In --------------------------------------------------------
# The OAuth *Web application* client id from Google Cloud Console
# (APIs & Services -> Credentials). The web client needs the same value in
# frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
#
# Authorised JavaScript origins must list the site the button is shown on -
# http://localhost:5000 in development, and the real origin in production.
# Leave this empty and the Google button is not offered at all: with no client
# id there is no audience to pin an ID token to, and a verifier that does not
# pin the audience would accept a token minted for a different app.
GOOGLE_CLIENT_ID=

# --- retention tests -------------------------------------------------------
# A concept taught today becomes eligible for a deterministic retention test
# this many days later. The scheduler decides when the test happens; the learned
# policy never does.
RETENTION_TEST_DELAY_DAYS=2
# How many due check-ins one sitting opens with, before today's first stage.
RETENTION_TESTS_PER_SITTING=3
# What a settled retention test pays the teaching episode that earned it. The
# leak penalty is larger than a passed test pays on purpose: a turn that hands
# the answer over must not be able to come out ahead.
REWARD_RETENTION_PASS=1.0
REWARD_TRANSFER_BONUS=0.35
PENALTY_RETENTION_FAIL=0.5
PENALTY_ANSWER_LEAK=1.5

# --- rate limiting ---------------------------------------------------------
# Per caller per minute, by route class. A signed-in caller is counted by their
# bearer token and a signed-out one by their IP address, with a higher per-IP
# ceiling over the top - see app/services/rate_limit.py for why. Set
# RATE_LIMIT_ENABLED=0 to turn the whole thing off without a code change.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=120
RATE_LIMIT_SPEECH_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_IP_PER_MINUTE=600
# 1 behind Render, Vercel or any proxy that overwrites X-Forwarded-For; without
# it every caller in the world shares the proxy's address and therefore one
# bucket. 0 when nothing sits in front of this server, because there the header
# is written by the client and says whatever they like.
RATE_LIMIT_TRUST_FORWARDED_FOR=1

# --- caching and the connection pool ---------------------------------------
# How long a browser may reuse an authored-content response (the curriculum,
# a level's games and notes) before revalidating. It always revalidates after
# this and is answered with 304 and no body when nothing changed.
CONTENT_CACHE_MAX_AGE_SECONDS=60
# PostgreSQL only; SQLite does not pool. Keep pool_size + max_overflow times the
# number of workers below whatever the managed database's connection cap is.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
# Well inside a managed Postgres's idle timeout: it closes an idle connection
# without telling the pool, and the first query on a dead one fails.
DATABASE_POOL_RECYCLE_SECONDS=1800

# --- email (SMTP) ----------------------------------------------------------
# Two things are sent from this app and both decide whether an account is
# reachable at all: the sign-in code, and the password-reset link.
#
# SMTP_PORT decides how the connection is secured, the way every provider
# documents it: 465 is implicit TLS, anything else is STARTTLS on a plain
# socket that is then upgraded. An upgrade that fails is a failure - a sign-in
# code in cleartext is not a second factor.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
#   and SMTP_PASSWORD must be a 16-character **App Password** from
#   https://myaccount.google.com/apppasswords (2-Step Verification has to be on
#   first). Your normal Gmail password will not work and should never go here.
# Zoho:  smtp.zoho.in / 465        Brevo: smtp-relay.brevo.com / 587
# Resend: smtp.resend.com / 587 with SMTP_USERNAME=resend and the API key as
#   the password. Mailgun and Postmark are the same shape.
#
# Leave SMTP_HOST empty in development and the sign-in code comes back in the
# response instead of an inbox, so the flow can still be finished. In
# production an empty host refuses the sign-in rather than skipping the code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# What the parent sees it came from. Most providers rewrite this to the
# authenticated account unless the address is a verified alias. Falls back to
# SMTP_USERNAME when empty.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Saksham IQ
SMTP_TIMEOUT_SECONDS=10

# --- sign-in code (OTP) ----------------------------------------------------
# A second factor on password sign-in: the password proves what the parent
# knows, the emailed code proves they still hold the address the account is on.
# Google sign-in skips it - Google has already proved the address.
# AUTH_OTP_ENABLED=0 turns it off and signs in on the password alone, which is
# what to set if this deployment cannot send mail.
AUTH_OTP_ENABLED=1
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_MINUTES=10
# Wrong guesses before the challenge dies. Six digits is one of a million only
# while the number of guesses is small.
AUTH_OTP_MAX_ATTEMPTS=5
# Seconds before "send it again" does anything, and how many times one sign-in
# may send mail to an address.
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_SENDS=4
# Where the reset link in the email points: the web app's own page, not this
# API. The parent clicks it, chooses a password on the site, and the site calls
# back here.
PASSWORD_RESET_URL=http://localhost:5000/forgot-password
