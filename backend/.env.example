LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# The AI Teacher playground's own model: the biggest one the account has.
GROQ_TEACHER_MODEL=openai/gpt-oss-120b
# The guide's voice, and the only one: Microsoft Edge's free neural voices.
# No key. This one reads English and Devanagari in the same sentence, which is
# how the app narrates Hindi. `edge-tts --list-voices` prints the rest.
EDGE_TTS_VOICE=hi-IN-SwaraNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
ENV=development
# The key that signs a parent's session token. Generate a fresh one per
# environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real one, and never reuse the development key in production -
# outside development an unset secret makes sign-in refuse rather than fall
# back to something guessable.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=saksham-iq
JWT_AUDIENCE=saksham-iq-app
# Thirty days, matching the auth_sessions row the token names.
JWT_TTL_MINUTES=43200

# --- retention tests -------------------------------------------------------
# A concept taught today becomes eligible for a deterministic retention test
# this many days later. The scheduler decides when the test happens; the learned
# policy never does.
RETENTION_TEST_DELAY_DAYS=2
# How many due check-ins one sitting opens with, before today's first stage.
RETENTION_TESTS_PER_SITTING=3
# What a settled retention test pays the teaching episode that earned it. The
# leak penalty is larger than a passed test pays on purpose: a turn that hands
# the answer over must not be able to come out ahead.
REWARD_RETENTION_PASS=1.0
REWARD_TRANSFER_BONUS=0.35
PENALTY_RETENTION_FAIL=0.5
PENALTY_ANSWER_LEAK=1.5
