
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# The AI Teacher playground's own model: the biggest one the account has.
GROQ_TEACHER_MODEL=openai/gpt-oss-120b
# The guide's voice, and the only one: Microsoft Edge's free neural voices.
# No key. This one reads English and Devanagari in the same sentence, which is
# how the app narrates Hindi. `edge-tts --list-voices` prints the rest.
EDGE_TTS_VOICE=hi-IN-SwaraNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
ENV=development
