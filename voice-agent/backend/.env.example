# Copy this file to backend/.env and fill in your key.
#   Windows:  copy backend\.env.example backend\.env
#   macOS/Linux:  cp backend/.env.example backend/.env
#
# backend/.env is git-ignored. Never commit a real key.

# ---- Required -------------------------------------------------------------
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---- Optional: where it listens -------------------------------------------
# Used by `python -m backend.main`. The `uvicorn` command takes --port instead,
# because uvicorn reads its own flags rather than this file.
HOST=127.0.0.1
PORT=8009

# ---- Optional: the AI --------------------------------------------------
# Any chat model your Groq account can use.
GROQ_MODEL=llama-3.3-70b-versatile
# A ceiling, not a target: the reply is going to be read out loud.
GROQ_MAX_TOKENS=300
GROQ_TEMPERATURE=0.6

# ---- Optional: the voice --------------------------------------------------
# The default female Hindi voice. It reads English too, with an Indian accent.
# See every option with:  edge-tts --list-voices
TTS_VOICE=hi-IN-SwaraNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_TIMEOUT=30

# ---- Optional: speech to text ---------------------------------------------
# browser  = the Web Speech API transcribes in the browser (default, no install)
# whisper  = faster-whisper transcribes on this server (pip install faster-whisper)
STT_ENGINE=browser
WHISPER_MODEL=base
# Leave empty to auto-detect the language, or pin it: en, hi
WHISPER_LANGUAGE=
